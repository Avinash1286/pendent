{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "jsx": "react-jsx", "jsxImportSource": "react", "strict": false,
    "resolveJsonModule": true, "esModuleInterop": true, "skipLibCheck": true,
    "types": ["tscircuit", "node"], "noEmit": true
  },
  "include": ["src/**/*.tsx", "src/**/*.ts", "scripts/**/*.tsx"]
}
