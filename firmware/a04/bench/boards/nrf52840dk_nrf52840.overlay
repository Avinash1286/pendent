/* SPDX-License-Identifier: MIT */
/* External unqualified bench wiring only. See ../WIRING.md. */
#include <zephyr/dt-bindings/gpio/gpio.h>
#include <zephyr/dt-bindings/pinctrl/nrf-pinctrl.h>
/ {
    bench_controls: bench-controls {
        compatible = "aura,bench-controls";
        mic-enable-gpios = <&gpio1 3 GPIO_ACTIVE_HIGH>;
        privacy-gpios = <&gpio1 4 (GPIO_ACTIVE_LOW | GPIO_PULL_UP)>;
    };
};
&spi1 { status = "disabled"; }; /* Default pins collide with PDM. */
&pwm0 { status = "disabled"; }; /* LED0 belongs to the bench application. */
&i2c1 { status = "disabled"; };
&uart1 { status = "disabled"; };
&pinctrl {
    bench_pdm_default: bench_pdm_default {
        group1 { psels = <NRF_PSEL(PDM_CLK, 0, 30)>, <NRF_PSEL(PDM_DIN, 0, 31)>; };
    };
    bench_spi_default: bench_spi_default {
        group1 { psels = <NRF_PSEL(SPIM_SCK, 1, 15)>, <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                        <NRF_PSEL(SPIM_MISO, 1, 14)>; };
    };
    bench_spi_sleep: bench_spi_sleep {
        group1 { psels = <NRF_PSEL(SPIM_SCK, 1, 15)>, <NRF_PSEL(SPIM_MOSI, 1, 13)>,
                        <NRF_PSEL(SPIM_MISO, 1, 14)>;
                 low-power-enable; };
    };
};
&pdm0 {
    compatible = "aura,nrf-pdm";
    status = "okay";
    pinctrl-0 = <&bench_pdm_default>;
    pinctrl-names = "default";
    clock-source = "PCLK32M_HFXO";
    queue-size = <4>;
};
&spi3 {
    status = "okay";
    pinctrl-0 = <&bench_spi_default>;
    pinctrl-1 = <&bench_spi_sleep>;
    pinctrl-names = "default", "sleep";
    cs-gpios = <&gpio1 12 GPIO_ACTIVE_LOW>;
    bench_nand: nand@0 {
        compatible = "aura,bench-nand";
        reg = <0>;
        spi-max-frequency = <1000000>;
    };
};
